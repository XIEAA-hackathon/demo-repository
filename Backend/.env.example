# PostgreSQL is required. Replace every placeholder outside source control.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800

# JWT signing. Replace this value outside local development.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Keep authentication CPU work bounded so login bursts cannot starve bidding,
# admin, timers, or WebSockets. Benchmark concurrency 3, 4, and 6 on the
# production 2-vCPU host before changing the default.
AUTH_BCRYPT_CONCURRENCY=4
AUTH_LOGIN_QUEUE_LIMIT=120
AUTH_LOGIN_QUEUE_TIMEOUT_SECONDS=20
AUTH_LOGIN_RETRY_AFTER_SECONDS=2
SESSION_HEARTBEAT_SECONDS=20
SESSION_STALE_SECONDS=90
SESSION_TOUCH_INTERVAL_SECONDS=15
DEPLOYED_COMMIT=development

# Comma-separated browser origins. The public Vite app uses 5173; the
# participant README documents 5174 when another Vite app already uses 5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# Startup-provisioned admin account. Never put production credentials here.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-this-password
ADMIN_NAME=Event Admin

# Reproducible demo seed accounts used by ``python -m scripts.seed_demo``.
# Use development/demo values only; keep live passwords outside Git.
DEMO_TEAM_NAME=Demo Team
DEMO_LEADER_EMAIL=leader@demo.example.com
DEMO_LEADER_PASSWORD=DemoLeader@123
DEMO_MEMBER_EMAIL=member@example.com
DEMO_MEMBER_PASSWORD=replace-with-demo-password
DEMO_ADMIN_EMAIL=admin.demo@bidtobuild.example.com
DEMO_ADMIN_PASSWORD=DemoAdmin@123
LEADERBOARD_DISPLAY_EMAIL=leaderboard@bidtobuild.example.com
LEADERBOARD_DISPLAY_PASSWORD=Leaderboard@123
